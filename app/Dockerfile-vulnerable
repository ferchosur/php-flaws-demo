# Runtime profile prior to the patches for CVE-2026-109618 and CVE-2026-109619.
# For VM (EC2, Azure VM, Compute Engine) and Kubernetes (EKS, AKS, GKE) only.
# The container runs with the seccomp jail app/seccomp-vulnerable.json (denies
# escape syscalls; command execution is blocked by PHP disable_functions + the
# absence of a shell) on VM, and seccompProfile RuntimeDefault + egress-deny
# NetworkPolicy on Kubernetes. Do not use on the serverless tier.
FROM php:8.5.11-cli-alpine

WORKDIR /srv
COPY web/ /srv/
COPY app/vulnerable/index.php /srv/index.php
COPY app/vulnerable/router.php /srv/router.php
COPY app/vulnerable/runtime-profile.js /srv/assets/runtime-profile.js

USER root
# chown BEFORE deleting busybox: chown is a busybox applet and disappears with the rm.
RUN adduser -D -H -u 101 lab \
 && chown -R 101:101 /srv \
 && rm -f /bin/sh /bin/ash /bin/busybox

USER 101:101
EXPOSE 8080
ENTRYPOINT ["php", "-d", "disable_functions=exec,shell_exec,system,passthru,proc_open,popen,pcntl_exec", "-d", "ffi.enable=0", "-S", "0.0.0.0:8080", "-t", "/srv", "/srv/router.php"]
