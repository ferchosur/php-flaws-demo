# "Careless prod" profile: PHP 8.5.11 vulnerable (CVE-2026-109618 / CVE-2026-109619)
# with NO hardening, to contrast with the hardened + seccomp profile.
#
# Unlike Dockerfile-vulnerable, this profile mimics a production deployment where
# security is not taken care of:
#   - runs as root,
#   - keeps a shell (/bin/sh, bash) and network tools (curl, nc),
#   - does NOT set disable_functions (exec/system/shell_exec remain available),
#   - no seccomp applied.
# Enables command execution and lateral movement inside the lab. Use only in the
# local cluster or in isolated, ephemeral labs. NEVER on the serverless tier or
# with broad cloud identity.
FROM php:8.5.11-cli-alpine

WORKDIR /srv
COPY web/ /srv/
COPY app/vulnerable/index.php /srv/index.php
COPY app/vulnerable/router.php /srv/router.php
COPY app/vulnerable/runtime-profile.js /srv/assets/runtime-profile.js

# Typical tools of a "batteries-included" prod image.
RUN apk add --no-cache bash curl busybox-extras

# No USER (root), no disable_functions, no ffi.enable=0.
EXPOSE 8080
ENTRYPOINT ["php", "-S", "0.0.0.0:8080", "-t", "/srv", "/srv/router.php"]
